      ],
      "webhookId": "0b0f7c1e-5a0e-4c4e-9a53-7d1d0e5f0a02"
    },
    {
      "parameters": {
        "jsCode": "// Verify Meta's X-Hub-Signature-256 header against the raw request body.\nconst crypto = require('crypto');\nconst secret = $env.WHATSAPP_APP_SECRET;\nconst item = $input.first();\nconst header = String(item.json.headers['x-hub-signature-256'] || '');\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\nconst a = Buffer.from(header);\nconst b = Buffer.from(expected);\nconst valid = a.length === b.length && crypto.timingSafeEqual(a, b);\nreturn [{ json: { valid, body: item.json.body } }];"
      },
      "id": "n-hmac",
      "name": "Check signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        640
      ]
    },
